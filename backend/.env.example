BHARATCODE_API_KEY=replace-with-your-bharatcode-api-key
BHARATCODE_BASE_URL=https://bharatcode.ai/api/model/v1
BHARATCODE_MODEL=qwen-3.8-27b
# Optional; defaults to 45 seconds. Retries only transient provider failures once.
# BHARATCODE_TIMEOUT_SECONDS=45

# Optional if Tesseract is not available on PATH.
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_LANG=eng

# Optional; defaults to backend/payguard.sqlite3. Render demo uses /tmp/payguard-demo.sqlite3.
# PAYGUARD_DATABASE_PATH=C:\path\to\payguard.sqlite3
# Set DEMO_MODE=true only for the isolated fictional hackathon demo.
# DEMO_MODE=false

# Required for a separate production frontend origin.
# PAYGUARD_CORS_ORIGINS=https://your-payguard-app.vercel.app
# PAYGUARD_COOKIE_SECURE=true
# PAYGUARD_COOKIE_SAMESITE=none
